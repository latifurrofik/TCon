# Salin ke environment variables server. Jangan commit file .env asli.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model dapat diganti sesuai akses dan ketersediaan akun.
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.7-flash

# Pisahkan dengan koma jika frontend di-host pada origin lain.
ALLOWED_ORIGINS=http://localhost:8000
