{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcon.example/schemas/asset-library.schema.json",
  "title": "TCon Asset Library",
  "type": "object",
  "required": ["schema_version", "library_name", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "library_name": {"type": "string"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "path", "category", "status", "sha256"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^AST-[A-F0-9]{12}$"},
          "path": {"type": "string"},
          "category": {"enum": ["TOKOH", "BACKGROUND", "OBJEK", "SIMBOL", "ELEMEN", "PERLU_REVIEW"]},
          "subcategory": {"type": ["string", "null"]},
          "description": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "layer_type": {"enum": ["character", "background", "object", "symbol", "effect", "composite", null]},
          "transparent_background": {"type": ["boolean", "null"]},
          "dimensions": {
            "type": ["object", "null"],
            "required": ["width", "height"],
            "properties": {
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          },
          "mime_type": {"type": ["string", "null"]},
          "file_size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "status": {"enum": ["pending_review", "approved", "rejected"]},
          "source": {"type": ["string", "null"]},
          "license": {"type": ["string", "null"]},
          "prompt": {"type": ["string", "null"]},
          "provenance": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
